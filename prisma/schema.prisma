generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

/// @map("_prisma_migrations")

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String?
  username       String?         @unique
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  bio            String?         @db.Text
  linkUrl        String?         @db.VarChar(255)
  linkText       String?         @db.VarChar(255)
  accounts       Account[]
  bookmarks      Bookmark[]
  recipes        Recipe[]
  sessions       Session[]
  tried          Tried[]
  credentials    UserCredential?
  usernameChange UsernameChange?
  votes          Vote[]
  contentReports ContentReport[]
  strikes        UserStrike[]
  adminStrikes   UserStrike[]    @relation("AdminStrikes")
  role           String          @default("USER")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("User")
}

model UserCredential {
  id             String @id @default(cuid())
  userId         String @unique
  hashedPassword String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserCredential_userId_User_fkey")

  @@map("UserCredential")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Account_userId_User_fkey")

  @@unique([provider, providerAccountId], map: "Account_provider_providerAccountId_unique")
  @@index([userId], map: "Account_userId_idx")
  @@map("Account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Session_userId_User_fkey")

  @@index([userId], map: "Session_userId_idx")
  @@map("Session")
}

model Recipe {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  instructions String      @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  authorId     String
  bookmarks    Bookmark[]
  author       User        @relation(fields: [authorId], references: [id], map: "Recipe_authorId_User_fkey")
  tags         RecipeTag[]
  tried        Tried[]
  votes        Vote[]
  contentReports ContentReport[]
  strikes      UserStrike[]

  @@index([authorId], map: "Recipe_authorId_idx")
  @@map("Recipe")
}

model Tag {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  recipes   RecipeTag[]

  @@map("Tag")
}

model RecipeTag {
  id       String  @id @default(cuid())
  name     String
  recipeId String
  tagId    String?
  recipe   Recipe  @relation(fields: [recipeId], references: [id], map: "RecipeTag_recipeId_Recipe_fkey")
  Tag      Tag?    @relation(fields: [tagId], references: [id], map: "RecipeTag_tagId_Tag_fkey")

  @@unique([name, recipeId], map: "RecipeTag_name_recipeId_unique")
  @@index([recipeId], map: "RecipeTag_recipeId_idx")
  @@index([tagId], map: "RecipeTag_tagId_idx")
  @@map("RecipeTag")
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  value     Int
  createdAt DateTime @default(now())
  recipe    Recipe   @relation(fields: [recipeId], references: [id], map: "Vote_recipeId_Recipe_fkey")
  user      User     @relation(fields: [userId], references: [id], map: "Vote_userId_User_fkey")

  @@unique([userId, recipeId], map: "Vote_userId_recipeId_unique")
  @@index([recipeId], map: "Vote_recipeId_idx")
  @@map("Vote")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())
  recipe    Recipe   @relation(fields: [recipeId], references: [id], map: "Bookmark_recipeId_Recipe_fkey")
  user      User     @relation(fields: [userId], references: [id], map: "Bookmark_userId_User_fkey")

  @@unique([userId, recipeId], map: "Bookmark_userId_recipeId_unique")
  @@index([recipeId], map: "Bookmark_recipeId_idx")
  @@map("Bookmark")
}

model Tried {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())
  recipe    Recipe   @relation(fields: [recipeId], references: [id], map: "Tried_recipeId_Recipe_fkey")
  user      User     @relation(fields: [userId], references: [id], map: "Tried_userId_User_fkey")

  @@unique([userId, recipeId], map: "Tried_userId_recipeId_unique")
  @@index([recipeId], map: "Tried_recipeId_idx")
  @@map("Tried")
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("PasswordReset")
}

model UsernameChange {
  id            String   @id @default(cuid())
  userId        String   @unique
  previousValue String?
  newValue      String
  changedAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UsernameChange_userId_User_fkey")

  @@map("UsernameChange")
}

model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  source    String?
  notes     String?

  @@map("WaitlistSignup")
}

model ContentReport {
  id          String   @id @default(cuid())
  recipeId    String
  recipeTitle String
  recipeSlug  String
  reporterId  String
  status      String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([recipeId], map: "ContentReport_recipeId_idx")
  @@index([reporterId], map: "ContentReport_reporterId_idx")
  @@index([status], map: "ContentReport_status_idx")
  @@index([createdAt], map: "ContentReport_createdAt_idx")
  @@map("ContentReport")
}

model UserStrike {
  id          String   @id @default(cuid())
  userId      String
  reason      String   @db.Text
  recipeId    String?
  recipeTitle String?
  adminId     String
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin       User     @relation("AdminStrikes", fields: [adminId], references: [id], onDelete: Cascade)
  recipe      Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([userId], map: "UserStrike_userId_idx")
  @@index([adminId], map: "UserStrike_adminId_idx")
  @@index([createdAt], map: "UserStrike_createdAt_idx")
  @@map("UserStrike")
}
